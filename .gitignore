# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment / secrets
.env
*.env
secrets.*

# Jarvis runtime data (keep the structure, ignore the contents)
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/*
data/notes/*
data/models/*
logs/*

# Keep the folders themselves
!data/backups/.gitkeep
!data/notes/.gitkeep
!data/models/.gitkeep
!logs/.gitkeep

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
